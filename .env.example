# ==============================================================================
# PadhAI Environment Configuration
# ==============================================================================

# AI Client Mock Mode
# Set to 'true' to run completely offline without an external API key.
MOCK_AI=true

# AI Provider API Key (Google Gemini / Anthropic / OpenAI via backend/ai/client.py)
GEMINI_API_KEY=""

# Backend server port
PORT=8000
BACKEND_URL="http://localhost:8000"

# Vector Store Path (for local SQLite / Chroma embeddings)
VECTOR_DB_DIR="./data/chroma"
SQLITE_DB_PATH="./data/padhai.db"

# Public App URL for production deployment
APP_URL="http://localhost:3000"
